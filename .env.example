# ---- Required ----------------------------------------------------------
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# From console.anthropic.com → API keys (set a monthly spend limit on the workspace)
ANTHROPIC_API_KEY=
# Your own Telegram user ID (message the bot /myid to get it)
ADMIN_CHAT_ID=

# Who may use the bot: "telegram_id:Name" pairs, comma-separated.
# Get each ID by having them message the bot /myid (or tap "Allow" on the
# unknown-user card the bot sends you).
ALLOWED_USERS=

# Required. Your first name, as the people you help will see it ("Alex will double-check this one").
OWNER_NAME=

# ---- Model -------------------------------------------------------------
# claude-sonnet-5-5 = good judgment + vision at moderate cost (default)
# claude-opus-5-5   = strongest, ~2x the price
# claude-haiku-5-5  = cheapest; weaker on subtle scams
CLAUDE_MODEL=claude-sonnet-5-5
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=3

# ---- Review policy -----------------------------------------------------
# MASTER SWITCH. false = analyze, log and card every case, but send NOTHING to
# anyone unless you tap a button on the Telegram card. The review knobs below
# only take effect once this is true. Flip to true when you trust the verdicts.
AUTO_SEND_ENABLED=false
# uncertain = auto-reply only confident scam verdicts (and damage-control);
#             anything that might say "it's real" waits for your approval
# always    = every reply waits for you
# never     = everything auto-replies (you still get a copy)
REVIEW_MODE=uncertain
AUTO_SEND_MIN_CONFIDENCE=80

# ---- Threat intel (optional, free) -------------------------------------
# Google Cloud console → enable "Safe Browsing API" → API key (non-commercial use)
GOOGLE_SAFE_BROWSING_KEY=
# virustotal.com → profile → API key (public tier: 4 lookups/min, non-commercial)
VIRUSTOTAL_API_KEY=
ENABLE_RDAP=true
# Expanding shortened links (bit.ly etc.) requests the link, which can tell the
# scammer the target is live. Leave false unless you accept that.
RESOLVE_REDIRECTS=false

# ---- iMessage bridge (iPhone Shortcuts automation) --------------------
# Leave BRIDGE_TOKEN empty to disable. Generate with:  openssl rand -hex 24
BRIDGE_TOKEN=
BRIDGE_PUBLIC_URL=https://<host>.<tailnet>.ts.net:8787
# Who the automation listens for. Keys can be a phone number AND/OR the exact contact
# name in your iPhone (case-insensitive) — list both for robustness.
# Example: +15555550123:Pat,Pat:Pat,+15555550199:Chris Lee,Chris Lee:Chris Lee
IMESSAGE_CONTACTS=
# Wait this long after their last text before analyzing (they often send the
# screenshot and "is this real?" as separate texts)
IMESSAGE_DEBOUNCE_SECONDS=10
# Prepended to every automatic iMessage so they know it's the bot, not you typing
IMESSAGE_REPLY_PREFIX="Scam check: "
# When a case needs your review, send them a "<OWNER_NAME> will double-check" text meanwhile
IMESSAGE_HOLD_MESSAGE=true
# If your iPhone hasn't picked up an automatic reply after this many seconds,
# Telegram pings you with a one-tap "Send via Messages" button
IMESSAGE_CLAIM_TIMEOUT=180

# ---- Misc --------------------------------------------------------------
# Seconds to wait for more messages (e.g. several screenshots) before analyzing
DEBOUNCE_SECONDS=6
MAX_CHECKS_PER_USER_PER_DAY=30
